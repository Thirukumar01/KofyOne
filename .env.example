# ==============================================================================
# KofyOne Environment Configuration
# Project: KofyOne - Learn Today. Build Tomorrow.
# ==============================================================================

# Next.js Application Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# Supabase Configuration (Authentication & Database)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# PostHog Analytics
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------------------
# Cloudflare R2 Media & Object Storage (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=kofyone-media
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.kofyone.com
