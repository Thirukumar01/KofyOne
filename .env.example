# ==============================================================================
# KofyOne Environment Configuration (.env.example)
# Copy this file to .env.local and populate with your own development credentials.
# NEVER commit .env.local or real secrets to source control.
# ==============================================================================

# Application URL & Environment
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Supabase Public Configuration (Required for client & SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret / Service Role Key (Required for Admin operations & Account Deletion)
# CRITICAL: NEVER prefix with NEXT_PUBLIC_ and NEVER expose to browser bundles!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Alternative alias supported:
# SUPABASE_SECRET_KEY=your-supabase-secret-key

# Optional Analytics & Storage
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.kofyone.com

# Optional Cloudflare R2 Credentials (Server-only)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kofyone-media

# ==============================================================================
# Cloudflare Turnstile Human Verification (Managed Mode)
# ==============================================================================
# Client-side Public Site Key (exposed to browser for rendering the widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side Secret Key (used by /api/auth/login and /api/auth/signup)
# CRITICAL: NEVER prefix with NEXT_PUBLIC_ and NEVER expose to client/browser!
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Official Cloudflare Testing Dummy Keys (For Local Development & Automated Tests)
# See: https://developers.cloudflare.com/turnstile/reference/testing/
#
# Always Passes:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#
# Always Blocks / Rejects:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=2x00000000000000000000AB
#   TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA
#
# Forces Interactive Challenge:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=3x00000000000000000000FF
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# ------------------------------------------------------------------------------

